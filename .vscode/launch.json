    "version": "0.2.0",
    "configurations": [
        {
            "name": "Extract CSV from Google TakeOut",
            "type": "debugpy",
            "request": "launch",
            "program": "AndroidCommon\\ExtractCsvFromGoogleTakeOut.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Build ALL",
            "type": "PowerShell",
            "request": "launch",
            "script": ".\\AndroidLibraryPlugin\\Build.ps1 | .\\AndroidMetadataPlugin\\Build.ps1",
            "cwd": "${cwd}"
        },
        {
            "name": "Build Library",
            "type": "PowerShell",
            "request": "launch",
            "script": ".\\AndroidLibraryPlugin\\Build.ps1",
            "cwd": "${cwd}"
        },
        {
            "name": "Build Metadata",
            "type": "PowerShell",
            "request": "launch",
            "script": ".\\AndroidMetadataPlugin\\Build.ps1",
            "cwd": "${cwd}"
        }
    ]
}